# Copy to .env.local for local overrides. Never commit real values to this repo.

# Address of a live-session relay (a WebSocket server speaking the protocol in
# scripts/session-relay.mjs), or an HTTP endpoint serving /api/live. Optional.
#   Unset in development: ws://localhost:8787 (the local relay).
#   Unset in production: Online sessions are peer-to-peer (WebRTC via PeerJS); no server needed.
#   Set to wss:// or https:// to route sessions through your own relay instead.
VITE_LIVE_SESSION_URL=

# The hosted site that Online sessions point joiners to, for a copy running on your
# own computer. Default: https://workableprojects.github.io/BohrifiedLauncher
VITE_ONLINE_SITE_URL=
