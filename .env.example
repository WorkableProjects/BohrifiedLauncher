# Copy to .env.local for local overrides. Never commit real values to this repo;
# on Netlify set them under Site configuration → Environment variables.

# Address of the live-session relay (a WebSocket server speaking the protocol in
# scripts/session-relay.mjs). Enables "Start live session" in Flow and the
# Join Whiteboard page. Must be wss:// in production.
#   Development default (when unset): ws://localhost:8787
#   Production: leave unset to turn live sessions off.
VITE_LIVE_SESSION_URL=
