{
  "name": "frames",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frames — Bohrified's presentation app: simple slides, deep customization, cinematic motion.",
  "scripts": {
    "player": "vite build --config vite.player.config.ts",
    "predev": "npm run player",
    "dev": "vite",
    "prebuild": "npm run player",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@bohrified/app-sdk": "*",
    "@bohrified/ui": "*",
    "fflate": "^0.8.2",
    "immer": "^10.1.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
